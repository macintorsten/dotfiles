#!/usr/bin/env bash
#MISE description="Bootstrap the committed HEAD in a clean Ubuntu container (needs Docker)"
set -euo pipefail

# Clone first: in a git worktree `.git` points outside the mount and breaks `--from`.
src="$(mktemp -d)"
trap 'rm -rf "$src"' EXIT
git clone -q "$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)" "$src/repo"

# The volume only caches downloads between runs; tools are still installed fresh.
docker run --rm -it -e MISE_GITHUB_TOKEN \
  -v dotfiles-test-cache:/root/.cache/mise -e MISE_DOWNLOADS_DIR=/root/.cache/mise/downloads \
  -v "$src/repo:/src:ro" ubuntu:latest bash -c '
  set -e
  apt-get update -qq && apt-get install -y -qq curl git ca-certificates >/dev/null
  git config --global --add safe.directory "*"
  curl -fsSL https://mise.run | sh
  ~/.local/bin/mise bootstrap --from /src --yes
  cd ~/.local/share/mise/bootstrap-repo
  ~/.local/bin/mise bootstrap status --missing
  exec bash -l
'
